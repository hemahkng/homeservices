<?xml version='1.0' encoding='utf-8'?>
<widget id="com.ours.homeservices" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>HomeServices</name>
    <description>Home services booking app</description>
    <author email="hemanthng0621.com" href="https://example.com">
        N G Hemanth Kumar
    </author>
    <content src="index.html" />

    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <preference name="Orientation" value="portrait" />

<platform name="android">
    <preference name="scheme" value="http" />
    <preference name="hostname" value="localhost" />
    <preference name="android-minSdkVersion" value="24" />
    <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
        <application android:usesCleartextTraffic="true" />
    </edit-config>
</platform>
</widget>